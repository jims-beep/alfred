# =============================================================================
# .env.example — Modèle de configuration / Configuration template
# FR : Copie ce fichier en ".env" puis remplis les valeurs.
#      NE JAMAIS committer le fichier .env !
# EN : Copy this file to ".env" then fill in the values.
#      NEVER commit the .env file!
# =============================================================================

# FR : Identifiants Telegram API (https://my.telegram.org -> API development tools).
# EN : Telegram API credentials.
API_ID=
API_HASH=
PHONE=+33612345678

# FR : Mot de passe 2FA — laisser vide si la 2FA est désactivée.
# EN : 2FA password — leave empty if 2FA is disabled.
PASSWORD=

# FR : Dossier des images et fichier des messages aléatoires.
# EN : Images folder and random messages file.
IMAGES_DIR=images
MESSAGES_FILE=messages.txt

# FR : Anti-spam : délai min entre deux réponses à la même personne (secondes).
# EN : Anti-spam: min delay between two replies to the same person (seconds).
COOLDOWN_SECONDS=300

# FR : Fourchette du délai humain avant réponse (secondes, tiré au hasard).
# EN : Human-delay range before replying (seconds, drawn at random).
REPLY_DELAY_MIN_SECONDS=8
REPLY_DELAY_MAX_SECONDS=25

# FR : Fichier d'état persistant (mode_absent).
# EN : Persistent state file (mode_absent).
STATE_FILE=data/state.json

# FR : Logging : fichier, taille max, nombre de rotations, niveau.
# EN : Logging: file, max size, rotation count, level.
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5
LOG_LEVEL=INFO

# FR : Résilience réseau Telethon : -1 = reconnexions illimitées, 5 s entre
#      chaque tentative.
# EN : Telethon network resilience: -1 = unlimited retries, 5s between tries.
CONNECTION_RETRIES=-1
RETRY_DELAY=5